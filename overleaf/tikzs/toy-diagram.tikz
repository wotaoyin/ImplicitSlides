
\begin{tikzpicture}

  \pgfplotsset{
    every axis/.append style={
      title style={at={(0.5,-0.18)}, anchor=north, font=\footnotesize}
    }
  }

\begin{groupplot}[
    group style={group size=5 by 1, horizontal sep=0.3cm},
    width=5cm, height=4cm,
    axis lines=middle,
    xmin=-2, xmax=3,
    ymin=-10, ymax=10,
    samples=50,
    clip=false,
    xlabel={$x$}, ylabel={$y$},
    tick align=outside,
    % legend style={draw=none, fill=none, font=\small},
]

% ---------------- Column 1: f(x) ----------------
\nextgroupplot[title={Target map $\cF(x)$}]
% f on three domains to avoid singularities
\addplot[thick, domain=-2:0] {-x};
\addplot[thick, domain=0.1:0.9] {1/x + 1/(x-1)};
\addplot[thick, domain=1.1:3] {1/(x-1) - 1/x};
% Asymptotes
\addplot[dashed] coordinates {(0,-10) (0,10)};
\addplot[dashed] coordinates {(1,-10) (1,10)};

% ---------------- Column 4: y10 = (1-(1-eps)^10) f ----------------
\nextgroupplot[title={$y_1(x)$}]
\addplot[thick, domain=-2:0] {(1 - (1 - min(0.1, abs(x*x*(x-1)*(x-1))))^5) * (-x)};
\addplot[thick, domain=0:1] {(1 - (1 - min(0.5, abs(x*x*(x-1)*(x-1))))^5) * (1/x + 1/(x-1))};
\addplot[thick, domain=1:3] {(1 - (1 - min(0.5, abs(x*x*(x-1)*(x-1))))^5) * (1/(x-1) - 1/x)};
\addplot[dashed] coordinates {(0,-10) (0,10)};
\addplot[dashed] coordinates {(1,-10) (1,10)};

% ---------------- Column 4: y10 = (1-(1-eps)^20) f ----------------
\nextgroupplot[title={$y_2(x)$}]
\addplot[thick, domain=-2:0] {(1 - (1 - min(0.1, abs(x*x*(x-1)*(x-1))))^20) * (-x)};
\addplot[thick, domain=0:1] {(1 - (1 - min(0.5, abs(x*x*(x-1)*(x-1))))^20) * (1/x + 1/(x-1))};
\addplot[thick, domain=1:3] {(1 - (1 - min(0.5, abs(x*x*(x-1)*(x-1))))^20) * (1/(x-1) - 1/x)};
\addplot[dashed] coordinates {(0,-10) (0,10)};
\addplot[dashed] coordinates {(1,-10) (1,10)};

% ---------------- Column 4: y10 = (1-(1-eps)^100) f ----------------
\nextgroupplot[title={$y_t(x)$}]
\addplot[thick, domain=-2:0] {(1 - (1 - min(0.1, abs(x*x*(x-1)*(x-1))))^100) * (-x)};
\addplot[thick, domain=0:1] {(1 - (1 - min(0.5, abs(x*x*(x-1)*(x-1))))^100) * (1/x + 1/(x-1))};
\addplot[thick, domain=1:3] {(1 - (1 - min(0.5, abs(x*x*(x-1)*(x-1))))^100) * (1/(x-1) - 1/x)};
\addplot[dashed] coordinates {(0,-10) (0,10)};
\addplot[dashed] coordinates {(1,-10) (1,10)};

% ---------------- Column 1: f(x) ----------------
\nextgroupplot[title={Fixed-point map $y_\ast(x)$}]
% f on three domains to avoid singularities
\addplot[thick, domain=-2:0] {-x};
\addplot[thick, domain=0.1:0.9] {1/x + 1/(x-1)};
\addplot[thick, domain=1.1:3] {1/(x-1) - 1/x};
% Asymptotes
\addplot[dashed] coordinates {(0,-10) (0,10)};
\addplot[dashed] coordinates {(1,-10) (1,10)};

\end{groupplot}
\end{tikzpicture}
